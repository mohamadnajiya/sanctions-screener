# Read by shared/deploy/windows/deploy-agent.bat and shared/deploy/server/install.sh (see shared/templates/agent.env).
AGENT_NAME="sanctions-screener"
AGENT_HOST="screen.noahsarch.tech"
AGENT_PORTS="8785 8786"
AGENT_MCP_PORT="8785"
AGENT_HEALTH_PORT="8786"
AGENT_HEALTH_URL="/v1/health"
AGENT_INGRESS="^/mcp(/.*)?$|8785;;|8786"
# Weekly list refresh (Mondays 03:17 server time): download the official lists into ./data, then restart the servers so they load the new snapshot.
AGENT_CRON_JOBS="17 3 * * 1|docker compose run --rm -T screen-refresh && docker compose restart screen-mcp screen-api"
AGENT_FIRST_RUN=""
AGENT_STATE_DIRS=""
SCREEN_PUBLIC_HOST="screen.noahsarch.tech"
SCREEN_MCP_PORT="8785"
SCREEN_API_PORT="8786"
